# ---- BACKEND (letak dalam Environment Variables di Render, bukan dalam fail yang di-commit) ----
ENV=production
SECRET_KEY=tukar-ke-rentetan-rawak-panjang
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
ADMIN_EMAIL=bkk@contoh.com
ADMIN_PASSWORD=password-kuat
REQUIRE_ROSTER=true
CORS_ORIGINS=https://pssgutm-app.onrender.com
UPLOAD_DIR=./uploads

# ---- FRONTEND (Environment Variable di Render Static Site) ----
VITE_API_URL=https://nama-backend-kau.onrender.com

# Lupa kata laluan melalui email (pilihan; tanpa ini, permintaan dihantar kepada admin)
BREVO_API_KEY=
MAIL_FROM=
FRONTEND_URL=https://pssgutm-app.onrender.com

# Log masuk dengan Google (pilihan): Client ID jenis Web dari Google Cloud Console
GOOGLE_CLIENT_ID=

# ---- Fasa 6 ----
# Butang "Reset semua data ujian" (Admin > Lagi). Hidupkan hanya semasa perlu, matikan selepas ujian.
ALLOW_RESET=false
# Prebet mesti sahkan "boleh bawa" setiap tarikh (true = disyorkan)
REQUIRE_PREBET_CONFIRM=true
# Peraturan perempuan tunggal dalam kereta pemandu lelaki
LONE_FEMALE_RULE=true
# Gambar lesen + tarikh tamat wajib sebelum daftar kenderaan
REQUIRE_LICENCE=true
ARREARS_BLOCK_DAYS=183

# ---- Fasa 7: masa & bayaran ----
CUTOFF_TIME=17:00            # selepas ini hanya admin boleh tambah/buang ahli (hari latihan)
AUTO_FINALISE_TIME=19:00     # BKK sahkan dari 5 PTG; jika tidak, auto-sah pada waktu ini
RETENTION_MONTHS=6           # padam gambar resit selesai & notifikasi lama selepas N bulan (0 = tutup). Rekod bayaran kekal
PAY_DEADLINE_TIME=12:00      # ahli bayar sebelum tengah hari esoknya
ARRIVE_EARLY_MINUTES=5
SITE_CONTACT_PHONE=0192278390
SITE_CONTACT_NAME=Pentadbir laman web
ELIGIBLE_YEARS=*             # * = semua sesi/tahun
# Bayaran tetap prebet sehari latihan (admin boleh ubah dalam app)
PAYOUT_CAR_DEKAT=10
PAYOUT_CAR_JAUH=14
PAYOUT_MOTOR_DEKAT=1
PAYOUT_MOTOR_JAUH=2
# Ujian sahaja: matikan semakan cutoff 5 petang
ENFORCE_CUTOFF=true
